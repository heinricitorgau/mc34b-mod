# GitHub Linguist settings (language bar and diffs).
# Linguist has no SPICE netlist language; "LTspice Symbol" is the closest one it knows,
# so netlists and models are counted under it. It is a data type, hence linguist-detectable.
*.cir linguist-language=LTspice-Symbol linguist-detectable
*.inc linguist-language=LTspice-Symbol linguist-detectable

# Generated by tools/*.py: excluded from language stats and collapsed in diffs.
simulations/ltspice/amp_stereo_psu_v1.cir linguist-generated
simulations/ltspice/amp_channel_v1_sat.cir linguist-generated
simulations/ltspice/*.asc linguist-generated
simulations/ltspice/*.asy linguist-generated
docs/figures/** linguist-generated
docs/data/*.csv linguist-generated
