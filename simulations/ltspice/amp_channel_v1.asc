TEXT 64 1840 Left 2 ;amp_channel_v1.asc -- GENERATED from amp_channel_v1.cir by tools/make_schematic.py. Parts connect through net labels. Edit the .cir and regenerate.
TEXT 64 1888 Left 2 !.include ../../models/tubes_amp.inc
TEXT 1664 1888 Left 2 !.include ../../models/elt10_est.inc
TEXT 64 1928 Left 2 !.options plotwinsize=0 numdgt=7
TEXT 1664 1928 Left 2 !.param VB=-42.9      ; fixed bias, trimmed for 34.4 mA/tube (sweep with .step to study bias)
TEXT 64 1968 Left 2 !.param RKO=1 CKO=1p  ; 1R cathode sense (fixed bias). Cathode-bias test: RKO=1.1k CKO=220u VB=0
TEXT 1664 1968 Left 2 !.param RD1=1k RD2=47k
TEXT 64 2008 Left 2 !.param RA1=330k RK2=2.7k   ; 2.7k: DC path via RFB is in parallel, Vgk ~ -0.9 V
TEXT 1664 2008 Left 2 !.param RT=15k RLA=18k RLB=18.82k
TEXT 64 2048 Left 2 !.param RFB=2.7k CFB=100p      ; v1.5: 100p lead cap (v1.4: none, v1.1-v1.3: 1n)
TEXT 1664 2048 Left 2 !.param VBPLUS=400        ; ideal B+ (V) for this single-channel netlist
TEXT 64 2088 Left 2 !.param RSTEP=3.3k CSTEP=470p ; V1 plate step network (v1.3+). Disable: RSTEP=1e9
TEXT 1664 2088 Left 2 !.param RZOB=10 CZOB=1u      ; output Zobel (v1.5; v1.4 10R+470n, v1.3 4.7R+100n). Disable: RZOB=1e9
TEXT 64 2128 Left 2 !.param RPZ=4.7k CPZ=2.2n    ; v1.5: plate-plate RC across the OPT primary (README 4.8). Disable: RPZ=1e9
TEXT 1664 2128 Left 2 !.param RL=4                 ; resistive load (ohm); 1e6 = no load
TEXT 64 2168 Left 2 !.param SPK=0                ; 1 = connect the estimated ELT 10 model (then set RL=1e6)
TEXT 1664 2168 Left 2 !.param DVB=0               ; V4 bias offset (V) relative to VB, for per-tube trim
TEXT 64 2208 Left 2 !.param KGA=1698 KGB=1698   ; KG1 of V3 / V4 (equal = matched pair; e.g. KGB=1783 = 5 % less current)
TEXT 1664 2208 Left 2 !.param AMP=0.5       ; input sine peak (V). ~0.6 Vpk = onset of clipping
TEXT 64 2248 Left 2 !.param LH=10 TU=0.43 KC=0.9995 RAA=6k   ; half-primary L (H), UL tap, coupling, primary Z (plate-plate)
TEXT 1664 2248 Left 2 !.param CPP=1p CPS=1p   ; OPT winding capacitance: plate-plate (CPP) and primary-secondary (CPS); 1p = off
TEXT 64 2288 Left 2 !K12 L1 L2 {KC}
TEXT 1664 2288 Left 2 !K13 L1 L3 {KC}
TEXT 64 2328 Left 2 !K14 L1 L4 {KC}
TEXT 1664 2328 Left 2 !K15 L1 L5 {KC}
